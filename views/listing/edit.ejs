<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body> 
        <form method="POST" action="/listening/<%= access._id%>?_method=PUT" > 
     <input name="listen[title]" value="<%= access.title %>" type="text">
