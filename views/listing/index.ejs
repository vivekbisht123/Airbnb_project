<% layout("/layouts/boilerplate") %>
<body>
    <h3>All Listing</h3>
   <!--<form method="GET" action="/listing/new">
        <button>Add</button>
    </form>  -->
    <div class="row row-cols-lg-3 row-cols-md-3 row-cols-sm-1">
   <% for (let list of allList) { %>
     <a  href="/listening/<%=list._id %>" class="listing_new" >
    <div class="card">
        <img
          src="<%= list.image.url %>" 
            class="card-img-top"
            alt='listing_image'
             style="height: 20rem;"
        >
        <div class="card-img-overlay"></div>
        <div class="card-body">
            <p class="card-text">
            <b> <%= list.title %></b><br>
               <%= list.price.toLocaleString("en-IN") %>/ night
            </p>
        </div>
    </div> 

    </a>

 <%} %>

</div>

   
    
</body>

