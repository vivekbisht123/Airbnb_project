<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Data</title>
</head>
<body>
    <h2>Fill the Form</h2>
    <form method="POST" action="/listening">
        <input name="listen[title]" placeholder="Enter title" type="text">
        <br></br>
        <textarea name="listen[description]" placeholder="Enter description" type="text"></textarea>
        <br></br>
        <input name="listen[image]" placeholder="Enter image URL/LINKS" type="text">
        <br></br>
        <input name="listen[price]" placeholder="Enter price" type="number">
        <br></br>
         <input name="listen[Country]" placeholder="Enter country name" type="text">
         <br><br>
        <input name="listen[location]" placeholder="Enter Location" type="text">
        
        <button>Add</button>
    </form>
</body>
</html>